# Contact form mail, sent through Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_USER=you@gmail.com
# A Gmail App Password (16 letters, no spaces), not the account password:
# https://myaccount.google.com/apppasswords
SMTP_PASS=
CONTACT_TO=you@gmail.com

# Optional bot check, Cloudflare Turnstile (dash.cloudflare.com > Turnstile).
# Leave both empty to turn it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub activity on the home page. A classic token with no scopes is enough.
# Leave empty and the section is left out.
GITHUB_TOKEN=
